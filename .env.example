# Django Core Settings
DJANGO_SECRET_KEY=replace-with-a-secure-50-char-secret-key-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Optional PostgreSQL Database Configuration (Defaults to SQLite db.sqlite3)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=rural_business_advisor
