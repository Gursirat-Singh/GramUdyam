# DB_PASSWORD=secret
# DB_HOST=localhost
# DB_PORT=5432

# Optional AI Provider Configuration (Falls back to Rule-Based Engine when unset)
AI_PROVIDER_ENABLED=False
AI_PROVIDER_NAME=openai_compatible
AI_API_KEY=
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL_NAME=gpt-4o-mini
AI_TIMEOUT_SECONDS=12
AI_RATE_LIMIT_PER_HOUR=15
